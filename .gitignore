# ==============================================================================
# DecisionBench .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll

# C extensions
*.c
*.h

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.direnv/

# Python tooling & caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.pyre/
.mypy_cache/
.pytype/
.ruff_cache/
.pyright/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vite/
.turbo/
.parcel-cache/

# Application Data & Persistent State
data/
backend/data/
/app/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Secrets, Environment Files & Keys
.secret_key
*.key
*.pem
*.cert
*.crt
.env
.env.*
!.env.example

# IDE, Editors & OS Files
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
.project
.pydevproject
.settings/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Docker / Container local artifacts
*.pid
*.seed
*.log
docker-compose.override.yml
